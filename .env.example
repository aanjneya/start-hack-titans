# Demo fallback mode: when true, all external APIs return deterministic mock data
MOCK_MODE=true

# Application ports & URLs
PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3000

# External API keys (leave blank when MOCK_MODE=true)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# --- Backend (Python agents, see backend/README.md) ---
# MOCK_MODE=true above also makes the agents run offline: no Claude calls, no emails, no portal calls.
# Claude API key for the agents (leave blank in MOCK_MODE; `ant auth login` also works instead of a key)
ANTHROPIC_API_KEY=
# Claude model + default effort used by backend/core/llm.py
ANTHROPIC_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Soony supplier portal (team token is on the portal's Settings page; never commit it)
SOONY_BASE_URL=https://start-hack-portal-cxh3crbdaef2f8gt.westeurope-01.azurewebsites.net
SOONY_API_TOKEN=
# Optional overrides (defaults shown)
# DATA_ROOT=challenge/start-hack-data/data
# DB_PATH=backend/data/truth.db
